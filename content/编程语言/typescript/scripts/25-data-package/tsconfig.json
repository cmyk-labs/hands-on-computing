{
  "compilerOptions": {
    "target": "ES2025",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "lib": [
      "ES2025"
    ],
    "types": [],
    "rootDir": "package/src",
    "outDir": "package/dist",
    "noEmitOnError": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true
  },
  "files": [
    "package/src/index.ts"
  ]
}
